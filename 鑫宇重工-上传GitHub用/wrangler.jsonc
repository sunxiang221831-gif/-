{
  // ==========================================================================
  // Cloudflare 部署配置
  //
  // 【什么时候需要这个文件】
  //   走 Workers 流程时需要（界面里出现 "Deploy command: npx wrangler deploy"）。
  //   走 Pages 流程时本文件会被忽略，留着也不影响。
  //
  // 【它做什么】
  //   告诉 Cloudflare：网站文件在 ./site 目录，把整个目录作为静态资源发布。
  //
  // 【网址由谁决定】
  //   下面的 name 决定 Worker 名字，进而决定 xxx.<你的账号>.workers.dev
  //   想换网址就改这一行，然后重新部署。
  // ==========================================================================
  "name": "xinyu-heavy",
  "compatibility_date": "2026-01-01",

  "assets": {
    // 网站文件所在目录（相对仓库根目录）
    "directory": "./site"
  }
}
